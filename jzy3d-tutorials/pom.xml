<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.jzy3d</groupId>
	<artifactId>jzy3d-tutorials</artifactId>
	<version>3.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Jzy3d Tutorials</name>

	<!-- Same Java requirements as the modules of the API, see the root pom : a module requiring a more recent
	JDK than Java 8 declares a skip-below-javaXX profile setting jzy3d.skip, so that with an older JDK it stays
	in the reactor but builds nothing -->
	<modules>
		<module>jzy3d-tutorials-emul-gl-swing</module>
		<module>jzy3d-tutorials-emul-gl-swt</module>     <!-- Java 11+ -->
		<module>jzy3d-tutorials-jogl-swing</module>
		<module>jzy3d-tutorials-jogl-newt</module>
		<module>jzy3d-tutorials-jogl-swt</module>        <!-- Java 11+ -->
		<module>jzy3d-tutorials-jogl-javafx</module>     <!-- Java 11+, 17+ and 19+ -->
		<module>jzy3d-tutorials-panama-gl-swing</module>  <!-- Java 22+ -->
		<module>jzy3d-tutorials-panama-gl-javafx</module> <!-- Java 22+ -->
		<module>jzy3d-tutorials-panama-gl-swt</module>    <!-- Java 22+ -->
	</modules>

	<!--To retrieve Jzy3d dependencies -->
	<repositories>

		<repository>
			<id>jzy3d-snapshots</id>
			<name>Jzy3d Snapshots</name>
			<url>https://maven.jzy3d.org/snapshots/</url>
			<releases><enabled>false</enabled></releases>
		</repository>

		<repository>
			<id>jzy3d-releases</id>
			<name>Jzy3d Releases</name>
			<url>https://maven.jzy3d.org/releases/</url>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>

	</repositories>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<version.java>8</version.java>

		<!-- Set to true by the skip-below-javaXX profile of a tutorial requiring a more recent JDK than the one
		running the build : it compiles, tests and installs nothing. Command line values still win. -->
		<jzy3d.skip>false</jzy3d.skip>
		<maven.main.skip>${jzy3d.skip}</maven.main.skip>
		<maven.test.skip>${jzy3d.skip}</maven.test.skip>
		<maven.source.skip>${jzy3d.skip}</maven.source.skip>
		<maven.install.skip>${jzy3d.skip}</maven.install.skip>
		<mdep.skip>${jzy3d.skip}</mdep.skip>
	</properties>

	<build>
		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>${version.java}</source>
					<target>${version.java}</target>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
				<!-- Tutorials are examples, not deployed -->
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.2.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>verify</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>
</project>
