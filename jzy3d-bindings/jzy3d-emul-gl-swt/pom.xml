<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.jzy3d</groupId>
		<artifactId>jzy3d-all</artifactId>
		<version>3.0.0-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>jzy3d-emul-gl-swt</artifactId>
	<name>Jzy3d EmulGL - SWT</name>
	<properties>
		<swt-version>3.116.100</swt-version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>jzy3d-jGL-swt</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
	<profiles>
		<!-- SWT 3.116 and OpenJFX are built for Java 11 : with an older JDK, stay in the reactor but build nothing -->
		<profile>
			<id>skip-below-java11</id>
			<activation>
				<jdk>(,11)</jdk>
			</activation>
			<properties>
				<jzy3d.skip>true</jzy3d.skip>
			</properties>
		</profile>
	</profiles>

</project>
